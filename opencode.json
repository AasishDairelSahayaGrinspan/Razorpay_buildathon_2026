{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-agent-skills",
    "opencode-agent-memory",
    "opencode-background-agents"
  ],
  "mcp": {
    "playwright-mcp": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@playwright/mcp"
      ]
    },
    "context7": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "environment": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "github-mcp-server": {
      "type": "remote",
      "enabled": true,
      "url": "https://api.githubcopilot.com/mcp/"
    }
  }
}