// Phase 2 — Merchant Catalog
// Prices in integer minor units (paise) — never float

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  merchantId  String   @default("merchant_demo")
  name        String
  description String
  category    String
  price       Int // paise, e.g. 399900 = ₹3,999
  currency    String   @default("INR")
  image       String? // reference / placeholder
  inventory   Int      @default(0)
  active      Boolean  @default(true)
  tags        String? // comma-separated for search
  features    String? // JSON string
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  cartItems CartItem[]

  @@index([merchantId])
  @@index([category])
  @@index([active])
}

enum CartStatus {
  ACTIVE
  CHECKOUT_READY
}

enum TransactionStatus {
  DRAFT
  CART_READY
  APPROVAL_PENDING
  APPROVED
  ORDER_CREATING
  ORDER_CREATED
  PAYMENT_PENDING
  PAYMENT_PROCESSING
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  PAYMENT_UNKNOWN
}

model Cart {
  id           String       @id @default(cuid())
  merchantId   String       @default("merchant_demo")
  status       CartStatus   @default(ACTIVE)
  currency     String       @default("INR")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  items        CartItem[]
  transactions Transaction[]
  auditEvents  AuditEvent[]

  @@index([merchantId])
  @@index([status])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Int // snapshot paise from Product.price at add time
  currency  String   @default("INR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
}

model Transaction {
  id                 String            @id @default(cuid())
  cartId             String
  cart               Cart              @relation(fields: [cartId], references: [id])
  merchantId         String            @default("merchant_demo")
  status             TransactionStatus @default(DRAFT)
  currency           String            @default("INR")
  cartHash           String
  total              Int // paise
  snapshot           String // JSON immutable cart snapshot
  razorpayOrderId    String?           @unique
  razorpayPaymentId  String?           @unique
  paymentStatus      String? // e.g. created, authorized, captured, failed
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  auditEvents AuditEvent[]

  @@unique([cartId, cartHash])
  @@index([cartId])
  @@index([merchantId])
  @@index([status])
  @@index([razorpayOrderId])
}

model AuditEvent {
  id                 String            @id @default(cuid())
  eventType          String
  transactionId      String?
  transaction        Transaction?      @relation(fields: [transactionId], references: [id])
  cartId             String?
  cart               Cart?             @relation(fields: [cartId], references: [id])
  requestId          String?
  timestamp          DateTime          @default(now())
  fromState          TransactionStatus?
  toState            TransactionStatus?
  cartHash           String?
  policyPassed       Int?
  policyTotal        Int?
  isSimulated        Boolean           @default(false)
  verificationSource String?

  @@index([transactionId])
  @@index([cartId])
  @@index([eventType])
}
